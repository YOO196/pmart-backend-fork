{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReturnInspected.v1.json",
  "title": "ReturnInspected",
  "description": "회수품 검수가 완료된 사실(상온 미개봉만 재판매). 발행 mfc-quality. 구독 claim, mfc-inventory. 토픽 mfc.quality.v1. (2026-11-19 MI-1·MQ-1) claimId 는 고객 반품일 때만(오배송 회수·전달 실패 반납은 purpose·caseId·originDeliveryId — 자동 환불 없음). 줄 orderLineId = 반입 줄의 주문 줄(같은 상품 두 줄이면 수량대로 나눔)",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReturnInspected"
        },
        "aggregateType": {
          "const": "ReturnInspection"
        },
        "payload": {
          "type": "object",
          "required": [
            "lines",
            "inspectedAt"
          ],
          "properties": {
            "inspectionId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "returnReceiptId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sku",
                  "qty",
                  "disposition"
                ],
                "properties": {
                  "sku": {
                    "$ref": "_defs.v1.json#/$defs/Sku"
                  },
                  "lot": {
                    "type": "string"
                  },
                  "qty": {
                    "$ref": "_defs.v1.json#/$defs/Qty"
                  },
                  "disposition": {
                    "type": "string",
                    "enum": [
                      "RESALE",
                      "DISPOSE"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "orderLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  }
                }
              },
              "minItems": 1
            },
            "inspectedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "CLAIM_RETURN",
                "MISDELIVERY_RECOVERY",
                "FAILED_DELIVERY_RETURN"
              ],
              "description": "없으면 CLAIM_RETURN"
            },
            "caseId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "originDeliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
