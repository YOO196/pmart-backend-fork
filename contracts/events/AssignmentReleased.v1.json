{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/AssignmentReleased.v1.json",
  "title": "AssignmentReleased",
  "description": "센터 관리자가 작업의 배정을 푼 사실(2026-11-27, mfc-capacity 0.36.0 — MFC 프론트 요청 \"배정 해제\"). 작업은 담당 없이 다음 작업 받기로 돌아간다. assignmentVersion 은 그 작업의 배정 버전보다 크다(투영은 더 새 버전만). 발행 mfc-capacity. 구독 mfc-inbound(입고 작업·이동 지시 담당 비움). 토픽 mfc.capacity.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "AssignmentReleased"
        },
        "aggregateType": {
          "const": "AssignmentPlan"
        },
        "payload": {
          "type": "object",
          "required": ["mfcId", "taskId", "taskType", "workerId", "assignmentVersion", "releasedBy", "reason", "releasedAt"],
          "properties": {
            "mfcId": { "$ref": "_defs.v1.json#/$defs/CenterId" },
            "taskId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "taskType": { "type": "string" },
            "workerId": { "$ref": "_defs.v1.json#/$defs/Ref", "description": "풀리기 전 담당" },
            "assignmentId": { "$ref": "_defs.v1.json#/$defs/Ref", "description": "풀린 배정" },
            "assignmentVersion": { "$ref": "_defs.v1.json#/$defs/Version", "description": "해제 버전(풀린 배정 버전보다 큼 — 다음 배정은 이보다 큼)" },
            "releasedBy": { "type": "string" },
            "reason": { "type": "string" },
            "releasedAt": { "$ref": "_defs.v1.json#/$defs/DateTime" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
